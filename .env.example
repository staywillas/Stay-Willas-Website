# Copy this file to .env and fill it with development-only values.
# Use an isolated development database. Never connect local work to production.

# Database
DATABASE_URL=
DIRECT_URL=

# Site URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Local admin, partner, and care access: use unique development credentials.
SESSION_SECRET=
# Legacy fallback name accepted by the application; prefer SESSION_SECRET.
NEXTAUTH_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
PARTNER_PASSWORD=
CARE_ADMIN_PIN=
CARETAKER_PIN=
CHEF_PIN=
ADMIN_API_KEY=

# Stripe test credentials
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Email and notifications (optional for local browsing)
ADMIN_NOTIFICATION_EMAIL=
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ENABLE_DEV_EMAILS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set these only for an explicitly reviewed database operation.
ALLOW_DATABASE_MUTATIONS=
CONFIRM_DATABASE_NAME=
ALLOW_INQUIRY_PURGE=
ALLOW_DESTRUCTIVE_SEED=
ALLOW_PRODUCTION_DATABASE_WRITES=

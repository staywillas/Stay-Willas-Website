// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Villa {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  location    String
  description String
  price          Float
  guests         Int
  baseGuests     Int      @default(12)
  extraGuestFee  Float    @default(0)
  bedrooms       Int
  bathrooms      Int
  images         String[]
  amenities      String[]
  category       String   @default("Mountain View")
  weekendPrice   Float?
  fridayPrice    Float?
  saturdayPrice  Float?
  sundayPrice    Float?
  iCalUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bookings       Booking[]
  reviews        Review[]
  seasonalPrices SeasonalPrice[]
  dailyPrices    DailyPrice[]
}

model Review {
  id        String   @id @default(cuid())
  villaId   String
  villa     Villa    @relation(fields: [villaId], references: [id])
  userId    String   // Clerk User ID
  userName  String
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now())

  @@index([villaId])
}

model Booking {
  id         String   @id @default(cuid())
  villaId    String
  villa      Villa    @relation(fields: [villaId], references: [id])
  userId     String   // Clerk User ID
  checkIn    DateTime
  checkOut   DateTime
  totalPrice Float
  status     String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, HELD, BLOCKED
  addOns     Json?    // Array of chosen packages
  kycName    String?
  kycGuests  Json?
  kycIdUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([villaId])
  @@index([status])
  @@index([checkIn, checkOut])
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String
  villaId   String?
  type      String   @default("GUEST") // GUEST or OWNER
  createdAt DateTime @default(now())
}

model SeasonalPrice {
  id        String   @id @default(cuid())
  villaId   String
  villa     Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  price     Float    // Price override for this specific period
  label     String?  // e.g., "New Year Peak"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villaId])
}

model DailyPrice {
  id        String   @id @default(cuid())
  villaId   String
  villa     Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)
  date      DateTime // Format: YYYY-MM-DD (stored as startOfDay)
  price     Float    // Daily price override
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([villaId, date])
  @@index([villaId])
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  passwordHash      String?  // PBKDF2 secure password hashes
  role              String   @default("guest") // guest, admin, partner
  isVerified        Boolean  @default(false)
  verificationToken String?  @unique
  resetToken        String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([verificationToken])
}

model CareLog {
  id        String   @id @default(cuid())
  role      String   // "caretaker" | "chef"
  staffName String   // e.g. "Caretaker (The Angle House)" or "Chef (The Angle House)"
  villaSlug String   @default("the-angle-house")
  category  String   // "POOL", "BEDROOMS", "BATHROOMS", "LIVING", "BREAKFAST", "LUNCH", "HI_TEA", "DINNER", "GENERAL"
  notes     String?
  images    String[] // Base64 or image URLs
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([villaSlug, createdAt])
  @@index([role, createdAt])
}

